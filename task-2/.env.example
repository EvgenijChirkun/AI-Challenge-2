# Copy to .env and fill in. Only the publishable (anon) key belongs here.
# The service role key is a server-only secret — never put it in this file
# or any client-readable env. Configure it in Lovable Cloud / Supabase.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
